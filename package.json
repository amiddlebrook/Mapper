{
  "name": "mapper",
  "version": "2.0.0",
  "private": true,
  "description": "Free Cloudflare-native map collections, private workspaces and public sharing",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "node --check src/worker.js && node --check public/app.js",
    "test": "node --test tests/*.test.js",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute mapper_db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute mapper_db --remote --file=./schema.sql"
  },
  "devDependencies": { "wrangler": "^4.45.0" }
}
